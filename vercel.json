{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "trailingSlash": false,
  "redirects": [
    { "source": "/leaderboard", "destination": "https://app.yumz.social/leaderboard", "permanent": false },
    { "source": "/leaderboard/", "destination": "https://app.yumz.social/leaderboard", "permanent": false },
    { "source": "/leaderboard/:path*", "destination": "https://app.yumz.social/leaderboard/:path*", "permanent": false },
    { "source": "/blog", "destination": "https://app.yumz.social/blog", "permanent": false },
    { "source": "/blog/", "destination": "https://app.yumz.social/blog", "permanent": false },
    { "source": "/blog/:path*", "destination": "https://app.yumz.social/blog/:path*", "permanent": false }
  ],
  "rewrites": [
    { "source": "/system/:path*", "destination": "/" },
    { "source": "/system", "destination": "/" },
    { "source": "/privacy/:path*", "destination": "/" },
    { "source": "/privacy", "destination": "/" },
    { "source": "/terms/:path*", "destination": "/" },
    { "source": "/terms", "destination": "/" },
    { "source": "/cookies/:path*", "destination": "/" },
    { "source": "/cookies", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
